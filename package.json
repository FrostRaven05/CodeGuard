{
  "name": "codeguard",
  "productName": "CodeGuard",
  "version": "0.1.5",
  "private": true,
  "description": "A Windows Git workbench for understanding local changes, reviewing what you are about to commit, and submitting it yourself.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:ux": "node --test tests/review-drafts.test.cjs tests/ux-review.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "format": "prettier --write src electron scripts tests vite.config.mjs index.html package.json",
    "preview:fixture": "node scripts/preview.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "electron-builder": "26.18.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
