{
  "appId": "local.codeguard.desktop",
  "productName": "CodeGuard",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "electron/**/*.cjs", "electron/assets/**/*", "package.json"],
  "asar": true,
  "npmRebuild": false,
  "publish": {
    "provider": "generic",
    "url": "https://codereview.frostraven05.com/updates/"
  },
  "win": {
    "icon": "electron/assets/codeguard.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "installerIcon": "electron/assets/codeguard.ico",
    "uninstallerIcon": "electron/assets/codeguard.ico",
    "installerHeaderIcon": "electron/assets/codeguard.ico",
    "artifactName": "${productName}-${version}-Setup-${arch}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CodeGuard",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
  }
}
